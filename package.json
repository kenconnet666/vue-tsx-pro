{
  "name": "vue-tsx-pro-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --configLoader native",
    "test:consumer": "node tests/consumer/run.mjs",
    "lint": "oxlint . --deny-warnings",
    "format": "prettier --write . --cache --cache-strategy content",
    "format:check": "prettier --check . --cache --cache-strategy content",
    "check:deps": "node scripts/structure/package-deps.mjs",
    "check:copies": "node scripts/structure/copies.mjs",
    "check:refs": "node scripts/structure/doc-refs.mjs",
    "check:text": "node scripts/text/check.mjs",
    "lsp:setup": "node scripts/language-services/setup.mjs",
    "lsp:verify": "node scripts/language-services/verify.mjs",
    "move": "node scripts/structure/move.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@prettier/plugin-oxc": "catalog:",
    "@types/node": "catalog:",
    "mdn-data": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pngjs": "catalog:",
    "prettier": "catalog:",
    "smol-toml": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "web-features": "catalog:",
    "zod": "catalog:"
  }
}
