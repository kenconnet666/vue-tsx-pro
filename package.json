{
  "name": "vue-tsx-pro-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "build:tsx": "pnpm --filter @zerodep-dev/vue-tsx-pro-tsx build",
    "dev:docs": "pnpm --filter @vue-tsx-pro/docs dev",
    "build:docs": "pnpm --filter @vue-tsx-pro/docs build",
    "build:host": "pnpm --filter @vue-tsx-pro/host-demo build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --configLoader native",
    "test:browser": "pnpm --filter \"./apps/**\" test:browser",
    "test:consumer": "node tests/consumer/run.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm css-docs:check && pnpm docs:check && pnpm exports:check && pnpm layers:check && pnpm themes:check && pnpm text:check",
    "lint": "oxlint . --deny-warnings",
    "format": "prettier --write . --cache --cache-strategy content",
    "format:check": "prettier --check . --cache --cache-strategy content",
    "css-docs": "node scripts/css-docs/generate.mjs",
    "css-docs:check": "node scripts/css-docs/generate.mjs --check",
    "docs:check": "node scripts/doc-comments/check.mjs",
    "docs:shot": "node scripts/docs/shot.mjs",
    "docs:review": "node scripts/docs/review.mjs",
    "docs:sheets": "node scripts/docs/contact-sheet.mjs",
    "docs:coverage": "node scripts/docs/coverage.mjs",
    "exports": "node scripts/exports/generate.mjs",
    "exports:check": "node scripts/exports/generate.mjs --check",
    "layers:check": "node scripts/structure/layers.mjs",
    "themes:check": "node scripts/themes/check.mjs",
    "text:check": "node scripts/text/check.mjs",
    "lsp:setup": "node scripts/language-services/setup.mjs",
    "lsp:verify": "node scripts/language-services/verify.mjs",
    "move": "node scripts/structure/move.mjs",
    "gen:globe-land": "node scripts/globe/land.mjs",
    "gen:trophy": "node scripts/models/trophy.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@prettier/plugin-oxc": "catalog:",
    "@types/node": "catalog:",
    "mdn-data": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pngjs": "catalog:",
    "prettier": "catalog:",
    "smol-toml": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "web-features": "catalog:",
    "zod": "catalog:"
  }
}
