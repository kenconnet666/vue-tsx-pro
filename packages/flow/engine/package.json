{
  "name": "@zerodep-dev/flow-ts-engine",
  "version": "0.1.0",
  "description": "Approval workflow engine in TypeScript on PostgreSQL: graph definitions, one command entry point, easy-query persistence, jobs for timers and async actions",
  "license": "Apache-2.0",
  "author": "lionheart (https://github.com/kenconnet666)",
  "homepage": "https://github.com/kenconnet666/vue-tsx-pro/tree/master/packages/flow#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/vue-tsx-pro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/vue-tsx-pro.git",
    "directory": "packages/flow/engine"
  },
  "keywords": [
    "workflow",
    "bpm",
    "approval",
    "typescript"
  ],
  "exports": {
    ".": {
      "@vue-tsx-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@vue-tsx-pro/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@zerodep-dev/easy-query-ts": "^0.2.4",
    "@zerodep-dev/easy-query-ts-pg": "^0.2.4",
    "@zerodep-dev/flow-ts-model": "workspace:^"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "^0.5.10"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:"
  }
}
