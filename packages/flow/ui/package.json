{
  "name": "@zerodep-dev/flow-ts-ui",
  "version": "0.1.0",
  "description": "Vue components for flow-ts built on vue-tsx-pro-ui: forms from field manifests, the approval panel, process diagrams and the field access matrix",
  "license": "Apache-2.0",
  "author": "lionheart (https://github.com/kenconnet666)",
  "homepage": "https://github.com/kenconnet666/vue-tsx-pro/tree/master/packages/flow#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/vue-tsx-pro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/vue-tsx-pro.git",
    "directory": "packages/flow/ui"
  },
  "keywords": [
    "workflow",
    "bpm",
    "approval",
    "vue",
    "form"
  ],
  "exports": {
    ".": {
      "@vue-tsx-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vite build --configLoader native && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p . --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run --configLoader native",
    "lint": "oxlint . --deny-warnings -c ../../../.oxlintrc.json",
    "format": "prettier --write . --ignore-path ../../../.prettierignore --cache --cache-strategy content",
    "format:check": "prettier --check . --ignore-path ../../../.prettierignore --cache --cache-strategy content"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@zerodep-dev/flow-ts-model": "workspace:^",
    "@zerodep-dev/vue-tsx-pro-tsx": "workspace:^",
    "@zerodep-dev/vue-tsx-pro-ui": "workspace:^"
  },
  "peerDependencies": {
    "@lucide/icons": "^1.69.0",
    "decimal.js": "^10.6.0",
    "vue": "^3.5.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@lucide/icons": "catalog:",
    "@types/node": "catalog:",
    "decimal.js": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:"
  }
}
