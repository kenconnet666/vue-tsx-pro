{
  "name": "@vue-tsx-pro/ui",
  "version": "0.0.0",
  "description": "vue-tsx-pro 组件库",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "@vue-tsx-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shiki": {
      "@vue-tsx-pro/source": "./src/config/shiki.ts",
      "types": "./dist/config/shiki.d.ts",
      "default": "./dist/config/shiki.js"
    },
    "./vue-router": {
      "@vue-tsx-pro/source": "./src/config/vue-router.ts",
      "types": "./dist/config/vue-router.d.ts",
      "default": "./dist/config/vue-router.js"
    },
    "./tokens.stylex": {
      "@vue-tsx-pro/source": "./src/config/theme/tokens.stylex.ts",
      "types": "./dist/config/theme/tokens.stylex.d.ts",
      "default": "./dist/config/theme/tokens.stylex.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@internationalized/date": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@vue-tsx-pro/tsx": "workspace:^",
    "animejs": "catalog:",
    "decimal.js": "catalog:",
    "tabbable": "catalog:"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "@lucide/icons": "^1.59.0",
    "pinia": "^4.0.0",
    "shiki": "^4.0.0",
    "@stylexjs/stylex": "^0.19.1",
    "three": ">=0.170.0",
    "@unovis/ts": "^1.7.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "pinia": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "@unovis/ts": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "echarts": "catalog:",
    "happy-dom": "catalog:",
    "@lucide/icons": "catalog:",
    "pinia": "catalog:",
    "@radix-ui/colors": "catalog:",
    "shiki": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "three": "catalog:",
    "@types/three": "catalog:",
    "typescript": "catalog:",
    "@unovis/ts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  }
}
