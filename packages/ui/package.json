{
  "name": "@vue-tsx-pro/ui",
  "version": "0.0.0",
  "description": "vue-tsx-pro 组件库",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./src/config/theme/tokens.ts",
    "./dist/config/theme/tokens.js"
  ],
  "exports": {
    ".": {
      "@vue-tsx-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shiki": {
      "@vue-tsx-pro/source": "./src/config/shiki.ts",
      "types": "./dist/config/shiki.d.ts",
      "default": "./dist/config/shiki.js"
    },
    "./pinyin": {
      "@vue-tsx-pro/source": "./src/config/pinyin.ts",
      "types": "./dist/config/pinyin.d.ts",
      "default": "./dist/config/pinyin.js"
    },
    "./charts": {
      "@vue-tsx-pro/source": "./src/charts/index.ts",
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./docs-kit": {
      "@vue-tsx-pro/source": "./src/docs-kit/index.ts",
      "types": "./dist/docs-kit/index.d.ts",
      "default": "./dist/docs-kit/index.js"
    },
    "./three": {
      "@vue-tsx-pro/source": "./src/three/index.ts",
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./patterns": {
      "@vue-tsx-pro/source": "./src/patterns/index.ts",
      "types": "./dist/patterns/index.d.ts",
      "default": "./dist/patterns/index.js"
    },
    "./workflow": {
      "@vue-tsx-pro/source": "./src/workflow/index.ts",
      "types": "./dist/workflow/index.d.ts",
      "default": "./dist/workflow/index.js"
    },
    "./vue-router": {
      "@vue-tsx-pro/source": "./src/config/vue-router.ts",
      "types": "./dist/config/vue-router.d.ts",
      "default": "./dist/config/vue-router.js"
    },
    "./xlsx": {
      "@vue-tsx-pro/source": "./src/xlsx/index.ts",
      "types": "./dist/xlsx/index.d.ts",
      "default": "./dist/xlsx/index.js"
    },
    "./theme-boot": {
      "@vue-tsx-pro/source": "./src/config/theme/boot.ts",
      "types": "./dist/config/theme/boot.d.ts",
      "default": "./dist/config/theme/boot.js"
    },
    "./theme-customize": {
      "@vue-tsx-pro/source": "./src/theme-customize/index.ts",
      "types": "./dist/theme-customize/index.d.ts",
      "default": "./dist/theme-customize/index.js"
    },
    "./tokens.stylex": {
      "@vue-tsx-pro/source": "./src/config/theme/tokens.stylex.ts",
      "types": "./dist/config/theme/tokens.stylex.d.ts",
      "default": "./dist/config/theme/tokens.stylex.js"
    },
    "./vars.stylex": {
      "@vue-tsx-pro/source": "./src/utils/style/vars.stylex.ts",
      "types": "./dist/utils/style/vars.stylex.d.ts",
      "default": "./dist/utils/style/vars.stylex.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --configLoader native && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@internationalized/date": "catalog:",
    "@radix-ui/colors": "catalog:",
    "@vue-tsx-pro/tsx": "workspace:^",
    "animejs": "catalog:",
    "culori": "catalog:",
    "decimal.js": "catalog:",
    "tabbable": "catalog:",
    "topojson-simplify": "catalog:"
  },
  "peerDependencies": {
    "@lucide/icons": "^1.59.0",
    "pinia": "^4.0.0",
    "shiki": "^4.0.0",
    "three": ">=0.170.0",
    "@unovis/ts": "^1.7.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0",
    "zod": "^4.6.0",
    "pinyin-pro": "^3.20.0",
    "exceljs": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "@unovis/ts": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    },
    "pinyin-pro": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    }
  },
  "vueTsxPro": {
    "optimizeDeps": {
      "include": [
        "@floating-ui/dom",
        "@internationalized/date",
        "@lucide/icons",
        "@radix-ui/colors",
        "@unovis/ts",
        "animejs",
        "culori/fn",
        "exceljs",
        "pinyin-pro",
        "shiki/core",
        "shiki/engine/javascript",
        "tabbable",
        "three",
        "three/addons/environments/RoomEnvironment.js",
        "three/addons/loaders/GLTFLoader.js",
        "topojson-simplify",
        "zod",
        "zod/v4/core",
        "zod/v4/locales/en.js",
        "zod/v4/locales/zh-CN.js"
      ],
      "exclude": [
        "shiki/langs"
      ]
    }
  },
  "devDependencies": {
    "happy-dom": "catalog:",
    "@lucide/icons": "catalog:",
    "pinia": "catalog:",
    "shiki": "catalog:",
    "three": "catalog:",
    "@types/three": "catalog:",
    "typescript": "catalog:",
    "@unovis/ts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:",
    "@types/culori": "catalog:",
    "pinyin-pro": "catalog:",
    "exceljs": "catalog:",
    "@types/topojson-simplify": "catalog:"
  }
}
