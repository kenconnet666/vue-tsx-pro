{
  "name": "@zerodep-dev/vue-tsx-pro-ui",
  "version": "0.3.3",
  "description": "vue-tsx-pro 组件库",
  "type": "module",
  "license": "MIT",
  "author": "kenconnet666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/vue-tsx-pro.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/kenconnet666/vue-tsx-pro#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/vue-tsx-pro/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui-library",
    "tsx",
    "accessibility",
    "design-system"
  ],
  "sideEffects": [
    "./src/config/theme/tokens.ts",
    "./dist/config/theme/tokens.js"
  ],
  "exports": {
    ".": {
      "@vue-tsx-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shiki": {
      "@vue-tsx-pro/source": "./src/config/shiki.ts",
      "types": "./dist/config/shiki.d.ts",
      "default": "./dist/config/shiki.js"
    },
    "./pinyin": {
      "@vue-tsx-pro/source": "./src/config/pinyin.ts",
      "types": "./dist/config/pinyin.d.ts",
      "default": "./dist/config/pinyin.js"
    },
    "./charts": {
      "@vue-tsx-pro/source": "./src/charts/index.ts",
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./docs-kit": {
      "@vue-tsx-pro/source": "./src/docs-kit/index.ts",
      "types": "./dist/docs-kit/index.d.ts",
      "default": "./dist/docs-kit/index.js"
    },
    "./three": {
      "@vue-tsx-pro/source": "./src/three/index.ts",
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./patterns": {
      "@vue-tsx-pro/source": "./src/patterns/index.ts",
      "types": "./dist/patterns/index.d.ts",
      "default": "./dist/patterns/index.js"
    },
    "./diagram": {
      "@vue-tsx-pro/source": "./src/diagram/index.ts",
      "types": "./dist/diagram/index.d.ts",
      "default": "./dist/diagram/index.js"
    },
    "./vue-router": {
      "@vue-tsx-pro/source": "./src/config/vue-router.ts",
      "types": "./dist/config/vue-router.d.ts",
      "default": "./dist/config/vue-router.js"
    },
    "./xlsx": {
      "@vue-tsx-pro/source": "./src/xlsx/index.ts",
      "types": "./dist/xlsx/index.d.ts",
      "default": "./dist/xlsx/index.js"
    },
    "./code-editor": {
      "@vue-tsx-pro/source": "./src/code-editor/index.ts",
      "types": "./dist/code-editor/index.d.ts",
      "default": "./dist/code-editor/index.js"
    },
    "./theme-boot": {
      "@vue-tsx-pro/source": "./src/config/theme/boot.ts",
      "types": "./dist/config/theme/boot.d.ts",
      "default": "./dist/config/theme/boot.js"
    },
    "./theme-customize": {
      "@vue-tsx-pro/source": "./src/theme-customize/index.ts",
      "types": "./dist/theme-customize/index.d.ts",
      "default": "./dist/theme-customize/index.js"
    },
    "./tokens": {
      "@vue-tsx-pro/source": "./src/config/theme/tokens.ts",
      "types": "./dist/config/theme/tokens.d.ts",
      "default": "./dist/config/theme/tokens.js"
    },
    "./vars": {
      "@vue-tsx-pro/source": "./src/utils/style/vars.ts",
      "types": "./dist/utils/style/vars.d.ts",
      "default": "./dist/utils/style/vars.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --configLoader native && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@internationalized/date": "catalog:",
    "@radix-ui/colors": "catalog:",
    "@zerodep-dev/vue-tsx-pro-tsx": "workspace:^",
    "animejs": "catalog:",
    "culori": "catalog:",
    "decimal.js": "catalog:",
    "tabbable": "catalog:",
    "topojson-simplify": "catalog:"
  },
  "peerDependencies": {
    "@lucide/icons": "^1.59.0",
    "pinia": "^4.0.0",
    "shiki": "^4.0.0",
    "three": ">=0.170.0",
    "@unovis/ts": "^1.7.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0",
    "zod": "^4.6.0",
    "pinyin-pro": "^3.20.0",
    "exceljs": "^4.4.0",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/language": "^6.13.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.0"
  },
