{
  "name": "@vue-tsx-pro/ui",
  "version": "0.0.0",
  "description": "vue-tsx-pro 组件库",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "@vue-tsx-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.stylex": {
      "@vue-tsx-pro/source": "./src/theme/tokens.stylex.ts",
      "types": "./dist/theme/tokens.stylex.d.ts",
      "default": "./dist/theme/tokens.stylex.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@internationalized/date": "catalog:",
    "@lucide/icons": "catalog:",
    "@standard-schema/spec": "catalog:",
    "@vue-tsx-pro/tsx": "workspace:^",
    "decimal.js": "catalog:",
    "tabbable": "catalog:"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@radix-ui/colors": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "zod": "catalog:"
  }
}
