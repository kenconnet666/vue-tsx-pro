{
  "name": "@vue-tsx-pro/tsx",
  "version": "0.0.0",
  "description": "更自然的 Vue TSX：组件边界、符文编译与 Vite 预设",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "@vue-tsx-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "@vue-tsx-pro/source": "./src/vite/index.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./stylex": {
      "@vue-tsx-pro/source": "./src/stylex/index.ts",
      "types": "./dist/stylex.d.ts",
      "default": "./dist/stylex.js"
    },
    "./compiler": {
      "@vue-tsx-pro/source": "./src/compiler/index.ts",
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./jsx-runtime": {
      "types": "./types/jsx-runtime.d.ts"
    },
    "./runes": {
      "types": "./types/runes.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p .",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "lightningcss": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stylexjs/stylex": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/babel__traverse": "catalog:",
    "happy-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
