{
  "name": "@zerodep-dev/vue-tsx-pro-tsx",
  "version": "0.3.2",
  "description": "更自然的 Vue TSX：组件边界、符文编译与 Vite 预设",
  "type": "module",
  "license": "MIT",
  "author": "kenconnet666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/vue-tsx-pro.git",
    "directory": "packages/tsx"
  },
  "homepage": "https://github.com/kenconnet666/vue-tsx-pro#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/vue-tsx-pro/issues"
  },
  "keywords": [
    "vue",
    "tsx",
    "jsx",
    "runes",
    "css-in-js",
    "stylex",
    "vite-plugin"
  ],
  "sideEffects": [
    "./shims/process.js",
    "./src/browser-compile/worker.ts",
    "./dist/browser-compile-worker.js"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": {
      "@vue-tsx-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "@vue-tsx-pro/source": "./src/vite/index.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./styles": {
      "@vue-tsx-pro/source": "./src/styles/index.ts",
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.js"
    },
    "./compiler": {
      "@vue-tsx-pro/source": "./src/compiler/index.ts",
      "types": "./dist/compiler.d.ts",
      "default": "./dist/compiler.js"
    },
    "./browser-compile": {
      "@vue-tsx-pro/source": "./src/browser-compile/index.ts",
      "types": "./dist/browser-compile.d.ts",
      "default": "./dist/browser-compile.js"
    },
    "./browser-compile/worker": {
      "@vue-tsx-pro/source": "./src/browser-compile/worker.ts",
      "types": "./dist/browser-compile-worker.d.ts",
      "default": "./dist/browser-compile-worker.js"
    },
    "./shims/fs": "./shims/fs.js",
    "./shims/assert": "./shims/assert.cjs",
    "./shims/process": "./shims/process.js",
    "./jsx-runtime": {
      "types": "./types/jsx-runtime.d.ts"
    },
    "./runes": {
      "types": "./types/runes.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "shims"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p . --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-typescript": "catalog:",
    "@vue/babel-plugin-jsx": "catalog:",
    "@vue/devtools-api": "catalog:",
    "pathe": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "happy-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "vueTsxPro": {
    "optimizeDeps": {
      "include": [
        "@vue/devtools-api"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
