{
  "name": "@zerodep-dev/easy-query-ts-pg",
  "version": "0.1.0",
  "description": "PostgreSQL adapter (pg) for @zerodep-dev/easy-query-ts",
  "license": "Apache-2.0",
  "author": "lionheart (https://github.com/kenconnet666)",
  "homepage": "https://github.com/kenconnet666/vue-tsx-pro/tree/master/packages/easy-query#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/vue-tsx-pro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/vue-tsx-pro.git",
    "directory": "packages/easy-query/pg"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "orm",
    "easy-query"
  ],
  "exports": {
    ".": {
      "@vue-tsx-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pglite": {
      "@vue-tsx-pro/source": "./src/pglite.ts",
      "types": "./dist/pglite.d.ts",
      "default": "./dist/pglite.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@zerodep-dev/easy-query-ts": "workspace:^",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "@zerodep-dev/easy-query-ts": "workspace:*",
    "@zerodep-dev/easy-query-ts-cache": "workspace:*",
    "@zerodep-dev/easy-query-ts-test": "workspace:*",
    "ioredis": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "tsc -b tsconfig.build.json"
  }
}
