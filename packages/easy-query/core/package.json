{
  "name": "@zerodep-dev/easy-query-ts",
  "version": "0.1.0",
  "description": "Type-safe query builder with implicit joins and subqueries, inferred result types and object-tree results (TypeScript port of easy-query)",
  "license": "Apache-2.0",
  "author": "lionheart (https://github.com/kenconnet666)",
  "homepage": "https://github.com/kenconnet666/vue-tsx-pro/tree/master/packages/easy-query#readme",
  "bugs": {
    "url": "https://github.com/kenconnet666/vue-tsx-pro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/vue-tsx-pro.git",
    "directory": "packages/easy-query/core"
  },
  "keywords": [
    "orm",
    "query-builder",
    "sql",
    "typescript",
    "easy-query"
  ],
  "exports": {
    ".": {
      "@vue-tsx-pro/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./context": {
      "@vue-tsx-pro/source": "./src/context.ts",
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./observe": {
      "@vue-tsx-pro/source": "./src/observe.ts",
      "types": "./dist/observe.d.ts",
      "default": "./dist/observe.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "tsc -b tsconfig.build.json"
  }
}
