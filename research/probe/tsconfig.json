{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "vue-tsx-pro",
    "types": [],
    "paths": {
      "vue-tsx-pro/jsx-runtime": [
        "./types/vue-tsx-pro/jsx-runtime/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "types-probe"
  ]
}