{
  "name": "@vue-tsx-pro/flow-demo",
  "version": "0.0.0",
  "private": true,
  "description": "流程引擎示例：Nitro 上的审批应用——发起、待办、审批、实例详情；框架与 fullstack-demo 同一层（第二次重复，ROADMAP 15 抽成 kit）",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc -p . --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test:e2e": "node test/e2e.mjs",
    "lint": "oxlint . --deny-warnings -c ../../.oxlintrc.json",
    "format": "prettier --write . --ignore-path ../../.prettierignore --cache --cache-strategy content",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --cache --cache-strategy content"
  },
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/search": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@floating-ui/dom": "catalog:",
    "@lucide/icons": "catalog:",
    "@zerodep-dev/easy-query-ts": "^0.2.4",
    "@zerodep-dev/easy-query-ts-pg": "^0.2.4",
    "@zerodep-dev/flow-ts-engine": "workspace:^",
    "@zerodep-dev/flow-ts-model": "workspace:^",
    "@zerodep-dev/vue-tsx-pro-kit": "workspace:^",
    "@zerodep-dev/vue-tsx-pro-tsx": "workspace:^",
    "@zerodep-dev/vue-tsx-pro-ui": "workspace:^",
    "nitro": "catalog:",
    "tabbable": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
