{
  "name": "@vue-tsx-pro/docs",
  "version": "0.0.0",
  "private": true,
  "description": "文档站：用 vue-tsx-pro 组件库自己写的 TSX 网站，开发时直接用各包源码（热更新）",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native && vite build --configLoader native --ssr src/entry-server.ts --outDir dist-ssr && node build/prerender.ts",
    "preview": "vite preview --configLoader native",
    "typecheck": "tsc -p . --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test:browser": "vitest run --configLoader native --config vitest.browser.config.ts",
    "lint": "oxlint . --deny-warnings -c ../../.oxlintrc.json",
    "format": "prettier --write . --ignore-path ../../.prettierignore --cache --cache-strategy content",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --cache --cache-strategy content",
    "test": "vitest run --configLoader native",
    "hydration": "node ../../scripts/docs/hydration.mjs",
    "shot": "node ../../scripts/docs/shot.mjs",
    "review": "node ../../scripts/docs/review.mjs",
    "sheets": "node ../../scripts/docs/contact-sheet.mjs",
    "states": "node ../../scripts/docs/states.mjs",
    "states-audit": "node ../../scripts/docs/states-audit.mjs",
    "coverage": "node ../../scripts/docs/coverage.mjs",
    "gen:trophy": "node ../../scripts/models/trophy.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/search": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/lsp-client": "catalog:",
    "@floating-ui/dom": "catalog:",
    "@internationalized/date": "catalog:",
    "@lezer/highlight": "catalog:",
    "@lucide/icons": "catalog:",
    "@shikijs/langs": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@zerodep-dev/easy-query-ts-pg": "^0.2.5",
    "@zerodep-dev/flow-ts-engine": "workspace:^",
    "@zerodep-dev/flow-ts-model": "workspace:^",
    "@zerodep-dev/flow-ts-ui": "workspace:^",
    "@zerodep-dev/vue-tsx-pro-tsx": "workspace:^",
    "@zerodep-dev/vue-tsx-pro-ui": "workspace:^",
    "decimal.js": "catalog:",
    "pinyin-pro": "catalog:",
    "rune-ui-font": "catalog:",
    "shiki": "catalog:",
    "tabbable": "catalog:",
    "three": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsgo-wasm": "catalog:",
    "@emotion/css": "catalog:",
    "@types/three": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue-tsx-pro/mobile-demo": "workspace:^",
    "axe-core": "catalog:",
    "happy-dom": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
