    "@zerodep-dev/vue-tsx-pro-tsx": "workspace:^",
    "@zerodep-dev/vue-tsx-pro-ui": "workspace:^",
    "animejs": "catalog:",
    "nitro": "catalog:",
    "tabbable": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
