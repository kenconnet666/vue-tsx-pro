{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "host-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@vue-tsx-pro/host-demo",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@vue-tsx-pro/docs",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "docs-shots",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "../vue-tsx-pro-shots/apps/docs",
        "exec",
        "vite",
        "--configLoader",
        "native",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "docs-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@vue-tsx-pro/docs",
        "preview",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "mobile-demo-h5",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@vue-tsx-pro/mobile-demo",
        "dev",
        "--port",
        "4321",
        "--strictPort"
      ],
      "port": 4321
    }
  ]
}
